<odoo>

    <record id="view_project_estimation_search"
            model="ir.ui.view">

        <field name="name">project.estimation.search</field>

        <field name="model">project.estimation</field>

        <field name="arch" type="xml">

            <search string="Project Estimation Search">

                <field name="customer_id"/>

                <field name="project_name"/>

                <field name="project_type"/>

                <field name="state"/>

                <separator/>

                <filter string="Draft"
                        name="draft"
                        domain="[('state','=','draft')]"/>

                <filter string="Review"
                        name="review"
                        domain="[('state','=','review')]"/>

                <filter string="Approved"
                        name="approved"
                        domain="[('state','=','approved')]"/>

                <filter string="Sent"
                        name="sent"
                        domain="[('state','=','sent')]"/>

                <separator/>

                <filter string="Customer"
                        name="group_customer"
                        context="{'group_by':'customer_id'}"/>

                <filter string="Project"
                        name="group_project"
                        context="{'group_by':'project_name'}"/>

                <filter string="Project Type"
                        name="group_project_type"
                        context="{'group_by':'project_type'}"/>

                <filter string="Status"
                        name="group_state"
                        context="{'group_by':'state'}"/>

            </search>

        </field>

    </record>


    <record id="view_project_estimation_tree" model="ir.ui.view">
        <field name="name">project.estimation.tree</field>
        <field name="model">project.estimation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="project_name"/>
                <field name="project_type"/>
                <field name="total_hours"/>
                <field name="total_price_inr"/>
                <field name="profitability"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_project_estimation_form" model="ir.ui.view">
        <field name="name">project.estimation.form</field>
        <field name="model">project.estimation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_review" type="object"
                            string="Review" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-success" invisible="state != 'review'"/>
                    <button name="action_send" type="object"
                            string="Send" class="btn-info" invisible="state != 'approved'"/>
                    <button name="action_reset_to_draft"
                            type="object"
                            string="Reset to Draft"
                            class="btn-secondary"
                            invisible="state == 'draft'" />
                    <button name="action_cancel"
                            type="object"
                            string="Cancel" confirm="Are You Sure"
                            class="btn-danger" invisible="state == 'cancel'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,review,approved,sent,cancel"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="customer_id"
                                   readonly="state != 'draft'"/>
                            <field name="industry_id"
                                   readonly="state not in ['draft','review']"/>
                            <field name="project_name"
                                   readonly="state != 'draft'"/>

                            <field name="project_type"
                                   readonly="state != 'draft'"/>
                        </group>

                        <group>
                            <field name="estimation_date"
                                   readonly="state != 'draft'"/>

                            <!--                            <field name="exchange_rate"-->
                            <!--                                   readonly="state != 'draft'"/>-->

                            <field name="currency_id"
                                   readonly="state != 'draft'"/>

                            <field name="exchange_rate"
                                   readonly="1"/>

                            <field name="profit_percentage"
                                   readonly="state != 'draft'"/>

                            <field name="quoted_amount"
                                   readonly="state != 'draft'"/>

                            <field name="quoted_amount_usd"
                                   readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Actual Estimation Details">
                            <field name="line_ids" readonly="state not in ['draft', 'review']">
                                <list editable="bottom">
                                    <field name="resource_type" />
                                    <field name="no_of_resources" sum="Total Resource"/>
                                    <field name="hourly_cost" />
                                    <field name="resource_hours" sum="Total Hrs"/>
                                    <!--                                    <field name="total_hours"/>-->
                                    <field name="cost_usd" sum="Total in USD"/>
                                    <field name="price_inr"/>
                                </list>
                            </field>
                        </page>
                        <page string="Module Costing">

                            <group>
                                <field name="total_module_cost" readonly="1"/>
                            </group>

                            <field name="module_line_ids">
                                <list editable="bottom">
                                    <field name="module_id"/>
                                    <field name="description" readonly="1"/>
                                    <field name="module_cost"/>
                                </list>
                            </field>

                        </page>
                        <page string="Client Approved Costing">

                            <field name="actual_line_ids"
                                   readonly="state not in ['draft', 'review']">

                                <list editable="bottom">

                                    <field name="resource_type_id"/>

                                    <field name="hourly_cost"/>

                                    <field name="actual_hours"/>

                                    <field name="cost_usd"/>

                                    <field name="price_inr"/>

                                    <field name="remarks"/>

                                </list>

                            </field>

                        </page>
                    </notebook>

                    <group>
                        <field name="total_hours" readonly="1"/>
                        <field name="total_price_inr" readonly="1"/>
                        <field name="profitability" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_project_estimation"
            model="ir.actions.act_window">
        <field name="name">Project Estimation</field>
        <field name="res_model">project.estimation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_project_estimation_search"/>

    </record>

    <odoo>

        <!-- Configuration Root Menu -->



        <!-- Customer Menu -->

        <record id="action_project_estimation_customer"
                model="ir.actions.act_window">

            <field name="name">Customers</field>

            <field name="res_model">res.partner</field>

            <field name="view_mode">list,form</field>

            <field name="domain">[('customer_rank','>',0)]</field>

        </record>



        <!-- Resource Type Menu -->

        <record id="action_project_resource"
                model="ir.actions.act_window">

            <field name="name">Resource Type</field>

            <field name="res_model">project.resource</field>

            <field name="view_mode">list,form</field>

        </record>



        <!-- Currency Menu -->

        <record id="action_project_currency"
                model="ir.actions.act_window">

            <field name="name">Currency</field>

            <field name="res_model">res.currency</field>

            <field name="view_mode">list,form</field>

        </record>



    </odoo>

