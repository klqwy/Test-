<odoo>
<record id="view_project_module_master_list" model="ir.ui.view">
    <field name="name">project.module.master.list</field>
    <field name="model">project.module.master</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="module_cost"/>
            <field name="active"/>
        </list>
    </field>
</record>

<record id="view_project_module_master_form" model="ir.ui.view">
    <field name="name">project.module.master.form</field>
    <field name="model">project.module.master</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="module_cost"/>
                    <field name="active"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<record id="action_project_module_master" model="ir.actions.act_window">
    <field name="name">Modules Master</field>
    <field name="res_model">project.module.master</field>
    <field name="view_mode">list,form</field>
</record>

</odoo>